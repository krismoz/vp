<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Kris Mozgovoi | Veebiprogrammeerimine</title>
	<link rel="styleSheet" href="/style/gallery.css">
	<script src="/script/gallery.js" defer></script>
</head>
<body>
	<img src="../pic/veebiprogrammeerimine_2026_AA.png" alt="banner">	<h1>Kris Mozgovoi | Veebiprogrammeerimine</h1>
	<p>Siin on kõik galeriise üles laetud avalikud pildid</p>
	<ul>
		<li><a href="/home">Avalehele</a></li>
		<li><a href="/logout">Logi välja</a></li>
	</ul>
	<hr>
	<!--Dialoogiaken normaalsuuruses fotode näitamiseks-->
	<dialog id="modal" class="modalarea">
		<span id="modalClose" class="modalclose">&times;</span>
		<div class="modalhorizontal">
			<div class="modalvertical">
				<p id="modalCaption"></p>
				<img id="modalImage" src="../pic/empty.png" alt="galeriipilt">
			</div>
		</div>
	</dialog>
	<div id="gallery" class="gallery">
		<% galleryPhotos.forEach(function(image) { %>
			<img src="<%=imagehref%><%=image.filename%>" alt="<%= image.alttext || "Galerii pilt" %>" data-id="<%=image.id%>" data-filename="<%=image.filename%>" class="thumbs">
		<% }); %>
	</div>
</body>
</html>